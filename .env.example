# Copia este archivo como .env y define los valores reales.
# .env nunca se sube al repositorio.

# Clave de firma de Django. Genera una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=pon-aqui-tu-clave

# Secreto compartido entre Django y los microservicios de pagos y
# notificaciones (cabecera X-Internal-Token). Genera uno con:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_API_TOKEN=pon-aqui-tu-token-interno

# Contraseñas de PostgreSQL (docker-compose.yml). Solo se aplican la primera
# vez que se crea el volumen postgres_data; para cambiarlas después hay que
# borrarlo con "docker compose down -v" (borra TODOS los datos).
POSTGRES_PASSWORD=pon-aqui-una-clave
CATALOG_DB_PASSWORD=pon-aqui-una-clave
PAYMENTS_DB_PASSWORD=pon-aqui-una-clave
NOTIFICATIONS_DB_PASSWORD=pon-aqui-una-clave

# Opcionales. Si no se definen se usan los valores de desarrollo local.
# Hosts a los que responde Django, separados por coma.
# ALLOWED_HOSTS=localhost,127.0.0.1
# URL base del catálogo que consume la web mediante el Adapter HTTP.
# CATALOG_SERVICE_URL=http://localhost/api/v1/
# URL de experiencias públicas de la API aliada MeetU2.
# MEETU2_API_URL=http://184.193.170.74/api/v1/integracion/experiencias-publicas/
# URL del catálogo público de atracciones turísticas de API-Colombia.
# API_COLOMBIA_URL=https://api-colombia.com/api/v1/TouristicAttraction
# Ruta del archivo SQLite (solo sin Docker, cuando no hay POSTGRES_HOST).
# SQLITE_PATH=db.sqlite3
