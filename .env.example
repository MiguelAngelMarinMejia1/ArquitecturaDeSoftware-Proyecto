# Copia este archivo como .env y define los valores reales.
# .env nunca se sube al repositorio.

# Clave de firma de Django. Genera una propia con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=pon-aqui-tu-clave

# Opcionales. Si no se definen se usan los valores de desarrollo local.
# Hosts a los que responde Django, separados por coma.
# ALLOWED_HOSTS=localhost,127.0.0.1
# Ruta del archivo SQLite.
# SQLITE_PATH=db.sqlite3
